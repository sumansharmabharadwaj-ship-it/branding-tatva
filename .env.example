# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already excluded in .gitignore.

# Email delivery for the contact form (set up in Phase 11)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional sender override. The domain must be verified in Resend.
CONTACT_FROM_EMAIL=

# Server-only authentication for the daily Vercel Contact delivery monitor.
# Generate a long random value and configure it in Vercel; never expose it with
# a NEXT_PUBLIC_ prefix.
CRON_SECRET=

# Optional: form honeypot / rate limiting secret
FORM_SECRET=

# Newsletter signup (Contact page) — get these from Mailchimp:
# API key: Account > Extras > API keys. Server prefix is the suffix on
# the key itself (e.g. "us21" in "abc123-us21"). Audience ID: Audience >
# Settings > Audience name and defaults > Audience ID.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
