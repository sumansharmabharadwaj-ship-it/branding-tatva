{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/fix_work_mobile_model_narrowing.py && python3 scripts/apply_services_practical_faq.py && pnpm build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- src public package.json pnpm-lock.yaml next.config.ts postcss.config.mjs tsconfig.json vercel.json",
  "git": {
    "deploymentEnabled": {
      "homepage-cinematic-recovery": false,
      "feat/insights-authority-hub": false,
      "staging/site-integration": false,
      "services-practical-faq": false
    }
  }
}
